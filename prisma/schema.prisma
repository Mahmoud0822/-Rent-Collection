generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MemberRole {
  manager
  staff
  @@map("member_role")
}
enum InvoiceKind {
  deposit
  rent
  @@map("invoice_kind")
}
enum PaymentMethod {
  cash
  bank_transfer
  online
  @@map("payment_method")
}
enum PaymentStatus {
  pending_verification
  approved
  rejected
  voided
  @@map("payment_status")
}
enum BillStatus {
  pending
  paid
  failed
  @@map("bill_status")
}

model Organization {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  memberships Membership[]
  units Unit[]
  tenants Tenant[]
  leases Lease[]
  invoices Invoice[]
  payments Payment[]
  paymentAllocations PaymentAllocation[]
  gatewayBills GatewayBill[]
  auditLogs AuditLog[]
  @@map("organizations")
}
model Membership {
  userId String @id @map("user_id") @db.Uuid
  orgId String @map("org_id") @db.Uuid
  role MemberRole
  organization Organization @relation(fields:[orgId], references:[id])
  @@map("memberships")
}
model Unit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  name String
  organization Organization @relation(fields:[orgId], references:[id])
  leases Lease[]
  @@unique([orgId,name])
  @@unique([id,orgId])
  @@map("units")
}
model Tenant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  fullName String @map("full_name")
  email String
  phone String?
  organization Organization @relation(fields:[orgId], references:[id])
  leases Lease[]
  @@unique([id,orgId])
  @@map("tenants")
}
model Lease {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  unitId String @map("unit_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime @map("end_date") @db.Date
  monthlyRentSen BigInt @map("monthly_rent_sen")
  depositSen BigInt @map("deposit_sen")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields:[orgId], references:[id])
  unit Unit @relation(fields:[unitId,orgId], references:[id,orgId])
  tenant Tenant @relation(fields:[tenantId,orgId], references:[id,orgId])
  invoices Invoice[]
  payments Payment[]
  gatewayBills GatewayBill[]
  @@unique([id,orgId])
  @@index([orgId])
  @@map("leases")
}
model Invoice {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  leaseId String @map("lease_id") @db.Uuid
  kind InvoiceKind
  periodIndex Int? @map("period_index")
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd DateTime? @map("period_end") @db.Date
  dueDate DateTime @map("due_date") @db.Date
  amountSen BigInt @map("amount_sen")
  reference String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields:[orgId], references:[id])
  lease Lease @relation(fields:[leaseId,orgId], references:[id,orgId])
  allocations PaymentAllocation[]
  @@unique([leaseId,kind,periodIndex])
  @@unique([id,orgId])
  @@index([leaseId,dueDate])
  @@map("invoices")
}
model GatewayBill {
  id String @id
  orgId String @map("org_id") @db.Uuid
  leaseId String @map("lease_id") @db.Uuid
  amountSen BigInt @map("amount_sen")
  status BillStatus @default(pending)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields:[orgId], references:[id])
  lease Lease @relation(fields:[leaseId,orgId], references:[id,orgId])
  payment Payment?
  @@unique([id,orgId])
  @@map("gateway_bills")
}
model Payment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  leaseId String @map("lease_id") @db.Uuid
  amountSen BigInt @map("amount_sen")
  unappliedSen BigInt @default(0) @map("unapplied_sen")
  method PaymentMethod
  status PaymentStatus
  receivedAt DateTime @map("received_at") @db.Timestamptz(6)
  slipPath String? @map("slip_path")
  gatewayBillId String? @map("gateway_bill_id")
  createdBy String? @map("created_by") @db.Uuid
  rejectionReason String? @map("rejection_reason")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields:[orgId], references:[id])
  lease Lease @relation(fields:[leaseId,orgId], references:[id,orgId])
  gatewayBill GatewayBill? @relation(fields:[gatewayBillId,orgId], references:[id,orgId])
  allocations PaymentAllocation[]
  @@unique([id,orgId])
  @@unique([gatewayBillId,orgId])
  @@index([leaseId,status])
  @@map("payments")
}
model PaymentAllocation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  amountSen BigInt @map("amount_sen")
  organization Organization @relation(fields:[orgId], references:[id])
  payment Payment @relation(fields:[paymentId,orgId], references:[id,orgId])
  invoice Invoice @relation(fields:[invoiceId,orgId], references:[id,orgId])
  @@unique([paymentId,invoiceId])
  @@map("payment_allocations")
}
model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String
  entityId String @map("entity_id")
  details Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields:[orgId], references:[id])
  @@map("audit_log")
}
